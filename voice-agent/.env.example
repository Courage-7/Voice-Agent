# Server Configuration
ENVIRONMENT=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO

# Deepgram Voice Agent API
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_AGENT_WS_URL=wss://agent.deepgram.com/agent
DEEPGRAM_STT_MODEL=nova-2
DEEPGRAM_TTS_MODEL=aura-asteria-en

# Groq LPU LLM Inference
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# Composio Integration Gateway (OAuth for Gmail, Outlook, SerpAI, Perplexity, Workspace...)
COMPOSIO_API_KEY=your_composio_api_key_here

# Supabase Long-Term Memory & Conversation Store
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_here
