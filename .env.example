# Copy to .env for local development. Never commit populated environment files.
ENVIRONMENT=development
DEEPGRAM_API_KEY=
GROQ_API_KEY=
COMPOSIO_API_KEY=
# Neon Serverless PostgreSQL Database
DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require
# Clerk server-side JWT verification. Copy the issuer and either the PEM public
# key or JWKS URL from Clerk Dashboard → Configure → API Keys.
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_JWT_KEY=
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://localhost:8000
# Optional when running from a checkout; required for a separately installed wheel.
# FRONTEND_DIST_PATH=/absolute/path/to/frontend/dist
