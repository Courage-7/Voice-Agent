  "cards": [
    {
      "dot": "cyan",
      "title": "Sub-300ms Realtime Voice Loop",
      "items": [
        "Three.js Cyber HUD streams full-duplex 16kHz linear16 PCM via Web Audio API with zero-gain feedback suppression",
        "FastAPI WebSocket gateway bridges audio chunks to Deepgram Nova-2 STT, VAD, and Aura-2 TTS with Groq LPU inference"
      ]
    },
    {
      "dot": "violet",
      "title": "Token Budgeting & Write Safety",
      "items": [
        "SpeechPayloadDistiller enforces a strict 1,200 character ceiling (~300 tokens) on all tool outputs to protect Groq context",
        "Tool registry enforces confirmation barriers on write operations and connects securely to Workspace via Composio OAuth"
      ]
    },
    {
      "dot": "emerald",
      "title": "State Persistence & Telemetry",
      "items": [
        "Supabase PostgreSQL stores relational users, multi-turn transcripts, and vector memories with automatic cache hydration",
        "Prometheus metrics collector records live p50, p95, and p99 latency percentiles alongside session turn metrics"
      ]
    }
  ]
